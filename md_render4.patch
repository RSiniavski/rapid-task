diff --git a/static/css/theme.css b/static/css/theme.css
index 85c6046..bb329c6 100644
--- a/static/css/theme.css
+++ b/static/css/theme.css
@@ -1506,3 +1506,27 @@ body.rm-linking, body.rm-linking * { cursor: crosshair !important; }
 .md a.tk-ref { text-decoration: none; background: var(--accent-soft); border-radius: 4px; padding: 0 4px; }
 .md a.tk-ref:hover { text-decoration: underline; }
 .md a:not([href]) { color: inherit; text-decoration: none; }
+
+/* ---- ticket link card: [icon] KEY | title (status) ---- */
+.md a.tk-ref.tk-card {
+  display: inline-flex; align-items: center; gap: 10px; max-width: 100%; vertical-align: middle;
+  margin: 2px 0; padding: 6px 12px 6px 8px; text-decoration: none; color: var(--text-1);
+  background: var(--bg-2); border: 1px solid var(--border-strong); border-radius: var(--radius-m);
+  transition: border-color var(--transition), background var(--transition);
+}
+.md a.tk-ref.tk-card:hover { border-color: var(--accent); background: var(--accent-soft); text-decoration: none; }
+.tk-card-icon {
+  flex: 0 0 auto; width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center;
+  border-radius: 8px; font-size: 15px; background: color-mix(in srgb, var(--chip, var(--type-task)) 28%, transparent);
+}
+.tk-card-key { flex: 0 0 auto; font-weight: 700; color: var(--accent); }
+.tk-card-sep { flex: 0 0 auto; width: 1px; height: 18px; background: var(--border-strong); }
+.tk-card-title { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 600; }
+.tk-card-status {
+  flex: 0 0 auto; display: inline-flex; align-items: center; gap: 6px; padding: 2px 10px; font-size: 12.5px;
+  border-radius: 999px; color: var(--text-1); background: var(--accent-soft);
+}
+.tk-card-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); }
+.tk-card.is-done .tk-card-status { background: var(--accent-2-soft); }
+.tk-card.is-done .tk-card-dot { background: var(--accent-2); }
+.tk-card.is-done .tk-card-title { color: var(--text-2); }
diff --git a/static/js/markdown.js b/static/js/markdown.js
index ac5504b..89167c7 100644
--- a/static/js/markdown.js
+++ b/static/js/markdown.js
@@ -133,11 +133,37 @@
   const titles = new Map();             // KEY -> Promise<{ title } | null>
   function lookup(key) {
     if (!titles.has(key)) {
-      titles.set(key, API.ticketByKey(key).then((t) => ({ title: t.title })).catch(() => null));
+      titles.set(key, API.ticketByKey(key).then((t) => ({
+        title: t.title, type: t.type,
+        status: t.column ? t.column.name : "", done: !!(t.column && t.column.is_done),
+      })).catch(() => null));
     }
     return titles.get(key);
   }
 
+  const span = (cls, text) => {
+    const el = document.createElement("span");
+    el.className = cls;
+    if (text !== undefined) el.textContent = text;
+    return el;
+  };
+
+  // the link becomes a small card: [type icon] KEY | title  (status)
+  function buildCard(a, key, info) {
+    const meta = typeof typeMeta === "function" ? typeMeta(info.type) : { icon: "🎫", colorVar: "--type-task" };
+    a.classList.add("tk-card");
+    a.classList.toggle("is-done", info.done);
+    a.textContent = "";
+    const icon = span("tk-card-icon", meta.icon);
+    icon.style.setProperty("--chip", `var(${meta.colorVar})`);
+    a.append(icon, span("tk-card-key", key), span("tk-card-sep"), span("tk-card-title", info.title));
+    if (info.status) {
+      const st = span("tk-card-status");
+      st.append(span("tk-card-dot"), document.createTextNode(info.status));
+      a.append(st);
+    }
+  }
+
   // add the titles; a key that is not a ticket (no access, no such ticket) goes back to plain text
   function hydrate(root) {
     if (!root || typeof API === "undefined" || !API.ticketByKey) return;
@@ -150,8 +176,8 @@
           if (a.dataset.fromText) a.replaceWith(document.createTextNode(key));   // a key typed in text: plain text again
           return;                                       // a real link stays a link
         }
-        if (!a.dataset.keepText) a.textContent = `${key} · ${info.title}`;
         a.title = info.title;
+        if (!a.dataset.keepText) buildCard(a, key, info);
       });
     });
   }
