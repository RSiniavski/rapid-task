# Copy to .env (never commit .env)
SECRET_KEY=change-me

# Platform admin tool (platform.html). The root admin is created / updated from these two values at every start.
# Without them the app still starts; the platform login page then shows "There are no platform admins here".
PLATFORM_ROOT_USERNAME=root
PLATFORM_ROOT_PASSWORD=change-me-please
# Optional:
# PLATFORM_SECRET_KEY=
# PLATFORM_TOKEN_MINUTES=480
# PLATFORM_MAX_FAILED_LOGINS=5
# PLATFORM_LOCK_MINUTES=15
